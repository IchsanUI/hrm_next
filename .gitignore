# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# uploaded files
/public/uploads

# backup dump files (dibuat lib/backup/run-backup.ts, jangan pernah masuk git)
/storage/backups

# dokumen pribadi pegawai (KTP/KK/NPWP/dst, lib/employee-document-storage.ts)
# — data identitas asli, jangan pernah masuk git.
/storage/dokumen-pegawai

# manual verification screenshots (dev-only artifacts)
/.verify-shots/


# preview PDF hasil scripts/preview-*.tsx (artefak dev)
/tmp/

# dump database manual (berisi data pegawai asli — NIK, gaji, hash password)
/backups/

# Artefak migrasi data master sekali-pakai (scripts/export-master-data.js +
# file .sql hasilnya) — dipakai buat memindahkan Jabatan/Bagian/Lokasi
# Kerja/Jam Kerja ke database tujuan tanpa input ulang manual. Isinya cuma
# data master, BUKAN data pegawai, tapi tetap tidak perlu masuk git: sifatnya
# sekali jalan & hasilnya sudah usang begitu master data di sumber berubah.
/hrm_next_master_data_export.sql
/scripts/export-master-data.js

# Docker — .env asli (isi kredensial) tetap kena rule ".env*" di atas, tapi
# .env.example (placeholder doang) SENGAJA boleh commit sebagai template.
!.docker/.env.example
# artefak runtime container (cert self-signed, log nginx/mariadb) — dibuat
# ulang tiap kali container jalan, tidak perlu masuk git.
/.docker/nginx/data/log/*
!/.docker/nginx/data/log/.gitkeep
/.docker/nginx/data/ssl/*
!/.docker/nginx/data/ssl/.gitkeep
/.docker/mariadb/data/
