enum LateArrivalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Izin Terlambat — diajukan real-time saat pegawai masih dalam perjalanan
// (mis. macet), lengkap dengan foto bukti kondisi. Alurnya generik, sama
// seperti Izin Lembur. PENTING: konfirmasi kedatangan (`arrivalConfirmedAt`)
// SENGAJA tidak digerbang oleh status approval — pegawai bisa konfirmasi
// sudah di kantor kapan saja, walau approval-nya belum diproses sama sekali.
// Ini cuma pencatatan sistem, bukan pengganti absen fingerprint yang tetap
// wajib dilakukan terpisah. `arrivalConfirmedVia` disiapkan untuk suatu saat
// diisi otomatis lewat scraping data mesin absensi, bukan cuma manual.
model LateArrivalRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // nomor referensi aman untuk URL, lihat lib/request-public-id.ts

  employeeId  Int
  reason      String @db.Text // alasan keterlambatan
  evidenceUrl String // foto bukti kondisi (JPG/PNG/PDF)

  locationLat   Float?
  locationLng   Float?
  locationLabel String? // lokasi saat MENGAJUKAN (bukan saat konfirmasi kedatangan) — mis. "Kantor Pusat" (di dalam radius) atau "45m dari Kantor Pusat"

  status          LateArrivalStatus @default(PENDING_APPROVAL)
  approverId      Int? // approver step yang sedang aktif — denormalized untuk tampilan cepat
  approvedAt      DateTime?
  rejectionReason String?           @db.Text

  arrivalConfirmedAt        DateTime?
  arrivalConfirmedVia       String? // "manual" | "admin_override" | "attendance_scrape" (belum diimplementasikan)
  arrivalLat                Float?
  arrivalLng                Float?
  arrivalLocationLabel      String? // mis. "Kantor Pusat" (di dalam radius) atau "45m dari Kantor Pusat" — data tambahan saja, tidak memblokir konfirmasi
  // Cuma terisi kalau arrivalConfirmedVia = "admin_override" — jejak audit
  // SIAPA (Super Admin) yang mengoreksi & KAPAN aksinya beneran dilakukan.
  // Beda dari arrivalConfirmedAt yang isinya jam kedatangan versi mesin
  // absen (angka yang diinput manual, bisa jauh dari waktu klik), field ini
  // real-time saat tombol dipencet — ditampilkan di detail pengajuan &
  // cetak PDF supaya jelas kalau datanya dikoreksi, bukan konfirmasi mandiri.
  arrivalConfirmedByAdmin   String?
  arrivalConfirmedByAdminAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee      Employee                  @relation("EmployeeLateArrivalRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver      Employee?                 @relation("EmployeeLateArrivalApprovals", fields: [approverId], references: [id])
  approvalSteps LateArrivalApprovalStep[]

  @@map("late_arrival_requests")
}

model LateArrivalApprovalStep {
  id           Int                @id @default(autoincrement())
  requestId    Int
  order        Int
  approverType ApprovalStepType
  approverId   Int? // Employee.id hasil resolusi, null kalau SKIPPED tanpa approver
  status       OvertimeStepStatus @default(WAITING)
  notes        String?            @db.Text // alasan reject, atau alasan skip
  actedAt      DateTime?
  createdAt    DateTime           @default(now())

  request          LateArrivalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?          @relation("EmployeeLateArrivalStepApprovals", fields: [approverId], references: [id])

  @@unique([requestId, order])
  @@index([approverId, status])
  @@map("late_arrival_approval_steps")
}

enum SickLeaveStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISI // pegawai pengganti menyatakan tidak bersedia — pemohon wajib pilih pengganti baru
}

// Step status generik (WAITING/IN_PROGRESS/APPROVED/REJECTED/SKIPPED) tidak
// cukup buat izin sakit — step PEGAWAI_PENGGANTI butuh nilai "REVISED" yang
// beda dari REJECTED, karena menolak jadi pengganti BUKAN menolak pengajuan
// sakitnya (lihat SickLeaveRequest untuk penjelasan alur revisi).
enum SickLeaveStepStatus {
  WAITING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  SKIPPED
}

// Izin Sakit — satu-satunya alur yang punya step PEGAWAI_PENGGANTI aktif.
// Kalau pengganti menyatakan tidak bersedia, step itu ditandai REVISED
// (bukan REJECTED) dan status pengajuan jadi REVISI — BUKAN gagal permanen.
// Pemohon lalu memilih pengganti baru lewat resubmitSickLeaveRequestAction,
// yang membuat baris SickLeaveApprovalStep BARU di `order` yang SAMA (baris
// lama tetap tersimpan sebagai riwayat, tidak ditimpa) — makanya
// SickLeaveApprovalStep TIDAK punya @@unique([requestId, order]) seperti
// jenis izin lain. Alur tidak mundur ke step 1, cuma mengulang step
// pengganti dengan orang baru.
//
// Surat Keterangan Sakit/Dokter (medicalCertificateUrl) sengaja BOLEH
// menyusul setelah pengajuan dibuat — tidak menghalangi approval berjalan.
model SickLeaveRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // nomor referensi aman untuk URL, lihat lib/request-public-id.ts

  employeeId Int
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String   @db.Text // alasan/deskripsi sakit

  substituteEmployeeId   Int? // opsional — step PEGAWAI_PENGGANTI di-skip kalau kosong
  substituteEmployeeName String? // snapshot nama, tetap akurat walau data pengganti berubah nanti

  medicalCertificateUrl        String?
  medicalCertificateUploadedAt DateTime?

  status          SickLeaveStatus @default(PENDING_APPROVAL)
  approverId      Int? // approver step yang sedang aktif — denormalized untuk tampilan cepat
  approvedAt      DateTime?
  rejectionReason String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee                @relation("EmployeeSickLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver           Employee?               @relation("EmployeeSickLeaveApprovals", fields: [approverId], references: [id])
  substituteEmployee Employee?               @relation("EmployeeSickLeaveSubstitute", fields: [substituteEmployeeId], references: [id])
  approvalSteps      SickLeaveApprovalStep[]

  @@map("sick_leave_requests")
}

model SickLeaveApprovalStep {
  id           Int                 @id @default(autoincrement())
  requestId    Int
  order        Int
  approverType ApprovalStepType
  approverId   Int? // Employee.id hasil resolusi, null kalau SKIPPED tanpa approver
  status       SickLeaveStepStatus @default(WAITING)
  notes        String?             @db.Text // alasan reject/revisi, atau alasan skip
  actedAt      DateTime?
  createdAt    DateTime            @default(now())

  request          SickLeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?        @relation("EmployeeSickLeaveStepApprovals", fields: [approverId], references: [id])

  // SENGAJA TIDAK unique([requestId, order]) — step pengganti bisa diulang
  // di order yang sama setelah revisi (lihat SickLeaveRequest).
  @@index([requestId, order])
  @@index([approverId, status])
  @@map("sick_leave_approval_steps")
}

enum CutiStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISI // pegawai pengganti menyatakan tidak bersedia — pemohon wajib pilih pengganti baru
}

// Sama seperti SickLeaveStepStatus — step PEGAWAI_PENGGANTI butuh nilai
// REVISED yang beda dari REJECTED (lihat penjelasan di CutiRequest).
enum CutiStepStatus {
  WAITING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  SKIPPED
}

// Izin Cuti (cuti tahunan) — alurnya kondisional berdasarkan durasi:
//  - <=3 hari: Kepala Departemen -> Pegawai Pengganti (opsional, sama
//    mekanisme tidak-bersedia/revisi seperti Izin Sakit) -> Direksi.
//  - >3 hari: sama seperti di atas, TAPI step PEGAWAI_TERTENTU yang
//    dikonfigurasi di Alur Approval (dipakai sebagai checkpoint HR) ikut
//    aktif SEBELUM Direksi. Kalau <=3 hari step PEGAWAI_TERTENTU itu
//    otomatis SKIPPED — jadi satu konfigurasi flow di Alur Approval
//    menangani kedua kondisi (lihat server/actions/cuti.ts).
// Dokumen pendukung (supportingDocumentUrl) WAJIB diisi saat pengajuan kalau
// durasi >3 hari (dihitung dari startDate/endDate saat submit) — beda dari
// Surat Keterangan Sakit di Izin Sakit yang boleh menyusul.
model CutiRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // nomor referensi aman untuk URL, lihat lib/request-public-id.ts

  employeeId Int
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String   @db.Text

  substituteEmployeeId   Int? // opsional — step PEGAWAI_PENGGANTI di-skip kalau kosong
  substituteEmployeeName String?

  supportingDocumentUrl String? // wajib kalau durasi >3 hari, lihat catatan di atas

  status          CutiStatus @default(PENDING_APPROVAL)
  approverId      Int? // approver step yang sedang aktif — denormalized untuk tampilan cepat
  approvedAt      DateTime?
  rejectionReason String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee           @relation("EmployeeCutiRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver           Employee?          @relation("EmployeeCutiApprovals", fields: [approverId], references: [id])
  substituteEmployee Employee?          @relation("EmployeeCutiSubstitute", fields: [substituteEmployeeId], references: [id])
  approvalSteps      CutiApprovalStep[]

  @@map("cuti_requests")
}

model CutiApprovalStep {
  id           Int              @id @default(autoincrement())
  requestId    Int
  order        Int
  approverType ApprovalStepType
  approverId   Int?
  status       CutiStepStatus   @default(WAITING)
  notes        String?          @db.Text
  actedAt      DateTime?
  createdAt    DateTime         @default(now())

  request          CutiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?   @relation("EmployeeCutiStepApprovals", fields: [approverId], references: [id])

  // SENGAJA TIDAK unique([requestId, order]) — sama alasan dengan SickLeaveApprovalStep.
  @@index([requestId, order])
  @@index([approverId, status])
  @@map("cuti_approval_steps")
}

// Saldo cuti tahunan per pegawai per tahun. quota = jatah default (admin bisa
// atur), adjustment = koreksi manual (carry-over, potongan disiplin, dst,
// bisa negatif). Hari terpakai TIDAK disimpan di sini — dihitung dinamis dari
// CutiRequest berstatus APPROVED yang overlap tahun berjalan (lihat
// lib/leave-balance.ts), supaya tidak ada dua sumber kebenaran yang bisa beda.
model EmployeeLeaveBalance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  year       Int
  quota      Int      @default(12)
  adjustment Int      @default(0)
  note       String?  @db.Text
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("employee_leave_balances")
}

enum MaternityLeaveType {
  BERSALIN // 1,5 bulan sebelum + 1,5 bulan sesudah HPL (Pasal 37 ayat 1)
  GUGUR_KANDUNGAN // 1,5 bulan dari tanggal kejadian (Pasal 37 ayat 2)
}

enum MaternityLeaveStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISI // pegawai pengganti menyatakan tidak bersedia — pemohon wajib pilih pengganti baru
}

// Sama seperti SickLeaveStepStatus/CutiStepStatus — step PEGAWAI_PENGGANTI
// butuh nilai REVISED yang beda dari REJECTED.
enum MaternityLeaveStepStatus {
  WAITING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  SKIPPED
}

// Cuti Bersalin/Gugur Kandungan (Pasal 37) — TIDAK memotong saldo Cuti
// Tahunan (EmployeeLeaveBalance), berdiri sendiri. Tanggal mulai/selesai
// dihitung otomatis dari HPL (Bersalin) atau tanggal kejadian (Gugur
// Kandungan) — lihat lib/validations/maternity-leave.ts — 1,5 bulan
// dibulatkan ke 45 hari kalender per sisi. Dokumen (surat keterangan dokter)
// WAJIB saat pengajuan, tidak boleh menyusul. Alur approval-nya generik,
// sama seperti Izin Sakit (KEPALA_DEPARTEMEN / PEGAWAI_PENGGANTI opsional
// dengan mekanisme tidak-bersedia / DIREKSI), diatur admin lewat Alur
// Approval — tidak ada logika kondisional khusus seperti Izin Cuti.
model MaternityLeaveRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // lihat lib/request-public-id.ts

  employeeId    Int
  type          MaternityLeaveType
  referenceDate DateTime           @db.Date // HPL (Bersalin) atau tanggal kejadian (Gugur Kandungan)
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String?            @db.Text

  substituteEmployeeId   Int? // opsional — step PEGAWAI_PENGGANTI di-skip kalau kosong
  substituteEmployeeName String?

  supportingDocumentUrl String // wajib saat pengajuan, tidak seperti Izin Sakit

  status          MaternityLeaveStatus @default(PENDING_APPROVAL)
  approverId      Int? // approver step yang sedang aktif — denormalized untuk tampilan cepat
  approvedAt      DateTime?
  rejectionReason String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee                     @relation("EmployeeMaternityLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver           Employee?                    @relation("EmployeeMaternityLeaveApprovals", fields: [approverId], references: [id])
  substituteEmployee Employee?                    @relation("EmployeeMaternityLeaveSubstitute", fields: [substituteEmployeeId], references: [id])
  approvalSteps      MaternityLeaveApprovalStep[]

  @@map("maternity_leave_requests")
}

model MaternityLeaveApprovalStep {
  id           Int                      @id @default(autoincrement())
  requestId    Int
  order        Int
  approverType ApprovalStepType
  approverId   Int?
  status       MaternityLeaveStepStatus @default(WAITING)
  notes        String?                  @db.Text
  actedAt      DateTime?
  createdAt    DateTime                 @default(now())

  request          MaternityLeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?             @relation("EmployeeMaternityLeaveStepApprovals", fields: [approverId], references: [id])

  // SENGAJA TIDAK unique([requestId, order]) — sama alasan dengan SickLeaveApprovalStep/CutiApprovalStep.
  @@index([requestId, order])
  @@index([approverId, status])
  @@map("maternity_leave_approval_steps")
}

enum SpecialLeaveType {
  HAJI // maks. 40 hari (Pasal 41 ayat 1)
  UMROH // maks. 20 hari (Pasal 41 ayat 2)
}

enum SpecialLeaveStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISI // pegawai pengganti menyatakan tidak bersedia — pemohon wajib pilih pengganti baru
}

enum SpecialLeaveStepStatus {
  WAITING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  SKIPPED
}

// Cuti Khusus Haji/Umroh (Pasal 41) — masing-masing jenis (HAJI/UMROH) cuma
// boleh diambil 1x seumur bekerja (ayat 3). Dicek di server saat pengajuan:
// kalau pegawai sudah pernah punya request jenis yang sama dengan status
// PENDING_APPROVAL/REVISI/APPROVED (REJECTED tidak dihitung karena tidak
// pernah benar-benar dipakai), pengajuan baru otomatis diblokir KECUALI
// admin membuka pengecualian lewat Employee.allowSpecialLeaveExceptionHaji/
// Umroh (lihat server/actions/special-leave.ts) — flag itu otomatis
// dipadamkan lagi begitu terpakai (`isException` di baris ini jadi
// penanda permanen bahwa pengajuan ini lahir dari pengecualian admin).
model SpecialLeaveRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // lihat lib/request-public-id.ts

  employeeId  Int
  type        SpecialLeaveType
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  reason      String?          @db.Text
  isException Boolean          @default(false) // true kalau lahir dari pengecualian admin (>1x)

  substituteEmployeeId   Int?
  substituteEmployeeName String?

  supportingDocumentUrl String // bukti pendaftaran/surat panggilan Haji/Umroh, wajib saat pengajuan

  status          SpecialLeaveStatus @default(PENDING_APPROVAL)
  approverId      Int?
  approvedAt      DateTime?
  rejectionReason String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee                   @relation("EmployeeSpecialLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver           Employee?                  @relation("EmployeeSpecialLeaveApprovals", fields: [approverId], references: [id])
  substituteEmployee Employee?                  @relation("EmployeeSpecialLeaveSubstitute", fields: [substituteEmployeeId], references: [id])
  approvalSteps      SpecialLeaveApprovalStep[]

  @@map("special_leave_requests")
}

model SpecialLeaveApprovalStep {
  id           Int                    @id @default(autoincrement())
  requestId    Int
  order        Int
  approverType ApprovalStepType
  approverId   Int?
  status       SpecialLeaveStepStatus @default(WAITING)
  notes        String?                @db.Text
  actedAt      DateTime?
  createdAt    DateTime               @default(now())

  request          SpecialLeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?           @relation("EmployeeSpecialLeaveStepApprovals", fields: [approverId], references: [id])

  @@index([requestId, order])
  @@index([approverId, status])
  @@map("special_leave_approval_steps")
}

// Pasal 44: 12 kategori kejadian, masing-masing punya durasi tetap KECUALI
// 4 kategori terakhir yang "berdasarkan perhitungan waktu yang wajar" (durasi
// bebas, dinilai approver) — lihat DISPENSATION_CATEGORY_FIXED_DAYS di
// lib/validations/dispensation.ts untuk pemetaan lengkapnya.
enum DispensationCategory {
  PERNIKAHAN_SENDIRI // 3 hari
  KELUARGA_INTI_MENINGGAL // 2 hari — suami/istri, anak kandung/angkat meninggal
  ORANG_TUA_MERTUA_MENINGGAL // 2 hari
  MENIKAHKAN_ANAK // 2 hari
  ISTRI_MELAHIRKAN_KEGUGURAN // 2 hari
  KHITAN_ANAK // 2 hari
  KELUARGA_SERUMAH_MENINGGAL // 1 hari
  PINDAH_RUMAH // 1 hari
  MELAYAT // wajar
  PANGGILAN_INSTANSI_PEMERINTAH // wajar
  MENGURUS_SIM // wajar
  UJIAN_PERGURUAN_TINGGI // wajar
}

enum DispensationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISI // pegawai pengganti menyatakan tidak bersedia — pemohon wajib pilih pengganti baru
}

enum DispensationStepStatus {
  WAITING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  SKIPPED
}

// Dispensasi (Pasal 44) — gaji penuh, TIDAK memotong saldo Cuti Tahunan.
// Beda dari Cuti Bersalin/Cuti Khusus, dokumen pendukung di sini OPSIONAL
// (pasal tidak mewajibkan surat apa pun secara eksplisit).
model DispensationRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // lihat lib/request-public-id.ts

  employeeId Int
  category   DispensationCategory
  startDate  DateTime             @db.Date
  endDate    DateTime             @db.Date
  reason     String               @db.Text // detail kejadian (mis. nama yang meninggal/menikah)

  substituteEmployeeId   Int?
