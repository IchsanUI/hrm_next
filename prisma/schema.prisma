// Hari libur nasional / cuti bersama — dipakai untuk perhitungan hari kerja
// pada modul absensi & pengajuan izin/cuti di pengembangan berikutnya.
model NationalHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  name      String
  // true kalau kantor tetap masuk di tanggal ini walau statusnya hari
  // libur nasional/cuti bersama (jadi TIDAK dikecualikan dari perhitungan
  // hari kerja Izin Cuti — lihat lib/working-days.ts).
  isOfficeOpen Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("national_holidays")
}

// Pengaturan per jenis izin (lihat lib/leave-types.ts untuk daftar
// `leaveType`) — di luar urutan approver yang sudah diatur lewat
// ApprovalFlow. Baris yang belum pernah diatur admin dianggap
// isActive=true & submissionCutoffTime=null (lihat lib/izin-type-settings.ts).
model IzinTypeSetting {
  id       Int    @id @default(autoincrement())
  leaveType String @unique

  isActive Boolean @default(true)

  // Batas jam pengajuan harian, format "HH:mm" — cuma relevan buat jenis izin
  // same-day (Lembur, Meninggalkan Kantor, Sakit, Pulang Cepat, Terlambat).
  // null = tidak ada batas jam.
  submissionCutoffTime String? @db.VarChar(5)

  updatedAt DateTime @updatedAt

  @@map("izin_type_settings")
}

// Konfigurasi alur approval per jenis izin (lihat lib/leave-types.ts untuk
// daftar `leaveType`). Saat ini logika runtime cuma benar-benar menjalankan
// step pertama bertipe ATASAN_LANGSUNG/KEPALA_DEPARTEMEN (Izin Lembur), dengan
// auto-skip ke step berikutnya kalau pemohonnya sendiri pejabat di step itu —
// step-step lain & jenis izin lain tersimpan sebagai konfigurasi, tunggu
// diaktifkan bertahap.
enum ApprovalStepType {
  ATASAN_LANGSUNG // atasan langsung pemohon (reportsToId), auto-skip kalau pemohon sendiri pejabatnya
  KEPALA_DEPARTEMEN // kepala departemen pemohon (Department.headEmployeeId), auto-skip kalau pemohon sendiri pejabatnya
  DIREKSI // direktur utama, approver tetap 1 pegawai (approverEmployeeId)
  HR
  PEGAWAI_PENGGANTI // konfirmasi kesediaan, bukan approval otorisasi
  PEGAWAI_TERTENTU // approver tetap 1 pegawai (approverEmployeeId)
}

model ApprovalFlow {
  id        Int      @id @default(autoincrement())
  leaveType String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalFlowStep[]

  @@map("approval_flows")
}

model ApprovalFlowStep {
  id                Int              @id @default(autoincrement())
  flowId            Int
  order             Int
  approverType      ApprovalStepType
  unlockAfter       Boolean          @default(false) // "Unlock aksi setelah step ini"
  approverEmployeeId Int? // dipakai kalau approverType = DIREKSI atau PEGAWAI_TERTENTU

  flow             ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  approverEmployee Employee?    @relation(fields: [approverEmployeeId], references: [id])

  @@unique([flowId, order])
  @@map("approval_flow_steps")
}

// ══════════════════════════════════════════════════════
//  ABSENSI — mesin fingerprint (ZK Premier Series)
//  Diadaptasi dari scrapperattendancephy/ (service Python terpisah yang
//  sebelumnya nulis ke database MySQL sendiri `attendsync`) — sekarang
//  ditulis langsung ke sini lewat Server Action "Ambil Data Mesin" di
//  menu Absensi, jadi tidak perlu service Python berjalan terus-menerus.
// ══════════════════════════════════════════════════════

// Daftar mesin fingerprint yang dikonfigurasi lewat menu Pengaturan Absensi.
model AttendanceDevice {
  id        Int      @id @default(autoincrement())
  name      String   @unique // nama lokasi, mis. "Pusat", "Bungah", "Menganti"
  ip        String
  loginUser String
  loginPass String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("attendance_devices")
}

// Log mentah hasil scraping mesin fingerprint — satu baris per event tap
// (Check-In/Check-Out/OT-In/OT-Out). userPin & name persis apa yang
// tercatat di mesin (bisa beda-beda per device/PIN belum tentu unik
// secara global). Penghubung ke Employee ada di Employee.pinAttendance
// (dipetakan MANUAL oleh admin) — BUKAN foreign key langsung, supaya data
// mentah tetap tersimpan apa adanya walau pemetaannya belum/tidak lengkap.
model AttendanceLog {
  id         Int      @id @default(autoincrement())
  userPin    String
  name       String   @default("")
  location   String   @default("Pusat")
  logTime    DateTime
  verifyType String   @default("Fingerprint") // PIN | Fingerprint | Card
  logType    String   @default("Check-In") // Check-In | Check-Out | OT-In | OT-Out — tetap disimpan apa adanya, TIDAK dihapus
  // Dihitung & disimpan SEKALI saat sync (bukan saat baris ini ditampilkan)
  // dengan membandingkan logTime ke jam WorkShift pegawai pemilik PIN ini
  // (lihat lib/attendance/attendance-note.ts) — "Terlambat" kalau Check-In
  // lewat jam masuk shift, "Pulang Cepat" kalau Check-Out sebelum jam
  // pulang shift, null kalau tepat waktu / PIN belum dipetakan / pegawai
  // belum punya shift.
  note       String?
  syncedAt   DateTime @default(now())

  @@unique([userPin, location, logTime])
  @@index([logTime])
  @@map("attendance_logs")
}

// Singleton (selalu id=1) — pengaturan interval polling kalau nanti mau
// dijadikan auto-sync berkala. Untuk sekarang dipakai sebagai penyimpanan
// preferensi, sync-nya sendiri dipicu manual lewat tombol "Ambil Data Mesin".
model AttendanceSettings {
  id          Int @id @default(1)
  pollSeconds Int @default(10)

  @@map("attendance_settings")
}
