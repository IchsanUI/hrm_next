  supportingDocumentUrl String? // opsional

  status          DispensationStatus @default(PENDING_APPROVAL)
  approverId      Int?
  approvedAt      DateTime?
  rejectionReason String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee                   @relation("EmployeeDispensationRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver           Employee?                  @relation("EmployeeDispensationApprovals", fields: [approverId], references: [id])
  substituteEmployee Employee?                  @relation("EmployeeDispensationSubstitute", fields: [substituteEmployeeId], references: [id])
