enum SickLeaveStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISI // pegawai pengganti menyatakan tidak bersedia — pemohon wajib pilih pengganti baru
}

// Step status generik (WAITING/IN_PROGRESS/APPROVED/REJECTED/SKIPPED) tidak
// cukup buat izin sakit — step PEGAWAI_PENGGANTI butuh nilai "REVISED" yang
// beda dari REJECTED, karena menolak jadi pengganti BUKAN menolak pengajuan
// sakitnya (lihat SickLeaveRequest untuk penjelasan alur revisi).
enum SickLeaveStepStatus {
  WAITING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  SKIPPED
}

// Izin Sakit — satu-satunya alur yang punya step PEGAWAI_PENGGANTI aktif.
// Kalau pengganti menyatakan tidak bersedia, step itu ditandai REVISED
// (bukan REJECTED) dan status pengajuan jadi REVISI — BUKAN gagal permanen.
// Pemohon lalu memilih pengganti baru lewat resubmitSickLeaveRequestAction,
// yang membuat baris SickLeaveApprovalStep BARU di `order` yang SAMA (baris
// lama tetap tersimpan sebagai riwayat, tidak ditimpa) — makanya
// SickLeaveApprovalStep TIDAK punya @@unique([requestId, order]) seperti
// jenis izin lain. Alur tidak mundur ke step 1, cuma mengulang step
// pengganti dengan orang baru.
//
// Surat Keterangan Sakit/Dokter (medicalCertificateUrl) sengaja BOLEH
// menyusul setelah pengajuan dibuat — tidak menghalangi approval berjalan.
model SickLeaveRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // nomor referensi aman untuk URL, lihat lib/request-public-id.ts

  employeeId Int
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String   @db.Text // alasan/deskripsi sakit

  substituteEmployeeId   Int? // opsional — step PEGAWAI_PENGGANTI di-skip kalau kosong
  substituteEmployeeName String? // snapshot nama, tetap akurat walau data pengganti berubah nanti

  medicalCertificateUrl      String?
  medicalCertificateUploadedAt DateTime?

  status          SickLeaveStatus @default(PENDING_APPROVAL)
  approverId      Int? // approver step yang sedang aktif — denormalized untuk tampilan cepat
  approvedAt      DateTime?
  rejectionReason String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee            Employee              @relation("EmployeeSickLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver            Employee?             @relation("EmployeeSickLeaveApprovals", fields: [approverId], references: [id])
  substituteEmployee   Employee?             @relation("EmployeeSickLeaveSubstitute", fields: [substituteEmployeeId], references: [id])
  approvalSteps        SickLeaveApprovalStep[]

  @@map("sick_leave_requests")
}

model SickLeaveApprovalStep {
  id           Int                 @id @default(autoincrement())
  requestId    Int
  order        Int
  approverType ApprovalStepType
  approverId   Int? // Employee.id hasil resolusi, null kalau SKIPPED tanpa approver
  status       SickLeaveStepStatus @default(WAITING)
  notes        String?             @db.Text // alasan reject/revisi, atau alasan skip
  actedAt      DateTime?
  createdAt    DateTime            @default(now())

  request          SickLeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?        @relation("EmployeeSickLeaveStepApprovals", fields: [approverId], references: [id])

  // SENGAJA TIDAK unique([requestId, order]) — step pengganti bisa diulang
  // di order yang sama setelah revisi (lihat SickLeaveRequest).
  @@index([requestId, order])
  @@index([approverId, status])
  @@map("sick_leave_approval_steps")
}

enum CutiStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISI // pegawai pengganti menyatakan tidak bersedia — pemohon wajib pilih pengganti baru
}

// Sama seperti SickLeaveStepStatus — step PEGAWAI_PENGGANTI butuh nilai
// REVISED yang beda dari REJECTED (lihat penjelasan di CutiRequest).
enum CutiStepStatus {
  WAITING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  SKIPPED
}

// Izin Cuti (cuti tahunan) — alurnya kondisional berdasarkan durasi:
//  - <=3 hari: Kepala Departemen -> Pegawai Pengganti (opsional, sama
//    mekanisme tidak-bersedia/revisi seperti Izin Sakit) -> Direksi.
//  - >3 hari: sama seperti di atas, TAPI step PEGAWAI_TERTENTU yang
//    dikonfigurasi di Alur Approval (dipakai sebagai checkpoint HR) ikut
//    aktif SEBELUM Direksi. Kalau <=3 hari step PEGAWAI_TERTENTU itu
//    otomatis SKIPPED — jadi satu konfigurasi flow di Alur Approval
//    menangani kedua kondisi (lihat server/actions/cuti.ts).
// Dokumen pendukung (supportingDocumentUrl) WAJIB diisi saat pengajuan kalau
// durasi >3 hari (dihitung dari startDate/endDate saat submit) — beda dari
// Surat Keterangan Sakit di Izin Sakit yang boleh menyusul.
model CutiRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique // nomor referensi aman untuk URL, lihat lib/request-public-id.ts

  employeeId Int
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String   @db.Text

  substituteEmployeeId   Int? // opsional — step PEGAWAI_PENGGANTI di-skip kalau kosong
  substituteEmployeeName String?

  supportingDocumentUrl String? // wajib kalau durasi >3 hari, lihat catatan di atas

  status          CutiStatus @default(PENDING_APPROVAL)
  approverId      Int? // approver step yang sedang aktif — denormalized untuk tampilan cepat
  approvedAt      DateTime?
  rejectionReason String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee           @relation("EmployeeCutiRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver            Employee?          @relation("EmployeeCutiApprovals", fields: [approverId], references: [id])
  substituteEmployee   Employee?          @relation("EmployeeCutiSubstitute", fields: [substituteEmployeeId], references: [id])
  approvalSteps        CutiApprovalStep[]

  @@map("cuti_requests")
}

model CutiApprovalStep {
  id           Int              @id @default(autoincrement())
  requestId    Int
  order        Int
  approverType ApprovalStepType
  approverId   Int?
  status       CutiStepStatus   @default(WAITING)
  notes        String?          @db.Text
  actedAt      DateTime?
  createdAt    DateTime         @default(now())

  request          CutiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?   @relation("EmployeeCutiStepApprovals", fields: [approverId], references: [id])

  // SENGAJA TIDAK unique([requestId, order]) — sama alasan dengan SickLeaveApprovalStep.
  @@index([requestId, order])
  @@index([approverId, status])
  @@map("cuti_approval_steps")
}

// Saldo cuti tahunan per pegawai per tahun. quota = jatah default (admin bisa
// atur), adjustment = koreksi manual (carry-over, potongan disiplin, dst,
// bisa negatif). Hari terpakai TIDAK disimpan di sini — dihitung dinamis dari
// CutiRequest berstatus APPROVED yang overlap tahun berjalan (lihat
// lib/leave-balance.ts), supaya tidak ada dua sumber kebenaran yang bisa beda.
model EmployeeLeaveBalance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  year       Int
  quota      Int      @default(12)
  adjustment Int      @default(0)
  note       String?  @db.Text
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("employee_leave_balances")
}

