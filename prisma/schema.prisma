// Pengaturan per jenis izin (lihat lib/leave-types.ts untuk daftar
// `leaveType`) — di luar urutan approver yang sudah diatur lewat
// ApprovalFlow. Baris yang belum pernah diatur admin dianggap
// isActive=true & submissionCutoffTime=null (lihat lib/izin-type-settings.ts).
model IzinTypeSetting {
  id        Int    @id @default(autoincrement())
  leaveType String @unique

  isActive Boolean @default(true)

  // Batas jam pengajuan harian, format "HH:mm" — cuma relevan buat jenis izin
  // same-day (Lembur, Meninggalkan Kantor, Sakit, Pulang Cepat, Terlambat).
  // null = tidak ada batas jam.
  submissionCutoffTime String? @db.VarChar(5)

  // Batas berapa kali TIPE IZIN INI boleh diajukan pegawai yang sama dalam
  // satu bulan kalender (dihitung dari createdAt pengajuan, bukan tanggal
  // kejadian) — cuma relevan buat jenis izin yang rawan disalahgunakan kalau
  // tanpa batas (mis. Izin Absen Diluar Kantor, Izin Tidak Absen). null =
  // tidak ada batas. Lihat IZIN_TYPES_WITH_MONTHLY_LIMIT di
  // lib/izin-type-settings-constants.ts buat daftar jenis yang mendukungnya.
  submissionLimitPerMonth Int?

  updatedAt DateTime @updatedAt

  @@map("izin_type_settings")
}

// Pengaturan umum modul Izin (singleton, id selalu 1 — sama pola dengan
// PayrollSettings/AttendanceSettings/BpjsSettings).
model IzinSettings {
  id Int @id @default(1)

  // Kop surat perusahaan (banner gambar — logo + nama + alamat sesuai desain
  // resmi mereka) — dipakai di bagian atas SEMUA format cetak surat izin
  // (IzinPrintPage generik, OvertimePrintPage, CutiFormalPrintPage). null =
  // PDF tampil tanpa kop surat (perilaku sebelumnya, header memang sengaja
  // dihilangkan — lihat catatan di lib/reports/izin-print-pdf.tsx).
  letterheadUrl String?

  updatedAt DateTime @updatedAt

  @@map("izin_settings")
}

// Konfigurasi alur approval per jenis izin (lihat lib/leave-types.ts untuk
// daftar `leaveType`). Saat ini logika runtime cuma benar-benar menjalankan
// step pertama bertipe ATASAN_LANGSUNG/KEPALA_DEPARTEMEN (Izin Lembur), dengan
// auto-skip ke step berikutnya kalau pemohonnya sendiri pejabat di step itu —
// step-step lain & jenis izin lain tersimpan sebagai konfigurasi, tunggu
// diaktifkan bertahap.
enum ApprovalStepType {
  ATASAN_LANGSUNG // atasan langsung pemohon (reportsToId), auto-skip kalau pemohon sendiri pejabatnya
  KEPALA_DEPARTEMEN // kepala departemen pemohon (Department.headEmployeeId), auto-skip kalau pemohon sendiri pejabatnya
  DIREKSI // direktur utama, approver tetap 1 pegawai (approverEmployeeId)
  HR
  PEGAWAI_PENGGANTI // konfirmasi kesediaan, bukan approval otorisasi
  PEGAWAI_TERTENTU // approver tetap 1 pegawai (approverEmployeeId)
}

model ApprovalFlow {
  id        Int      @id @default(autoincrement())
  leaveType String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalFlowStep[]

  @@map("approval_flows")
}

model ApprovalFlowStep {
  id                 Int              @id @default(autoincrement())
  flowId             Int
  order              Int
  approverType       ApprovalStepType
  unlockAfter        Boolean          @default(false) // "Unlock aksi setelah step ini"
  approverEmployeeId Int? // dipakai kalau approverType = DIREKSI atau PEGAWAI_TERTENTU

  flow             ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  approverEmployee Employee?    @relation(fields: [approverEmployeeId], references: [id])

  @@unique([flowId, order])
  @@map("approval_flow_steps")
}

// ══════════════════════════════════════════════════════
//  ABSENSI — mesin fingerprint (ZK Premier Series)
//  Diadaptasi dari scrapperattendancephy/ (service Python terpisah yang
//  sebelumnya nulis ke database MySQL sendiri `attendsync`) — sekarang
//  ditulis langsung ke sini lewat Server Action "Ambil Data Mesin" di
//  menu Absensi, jadi tidak perlu service Python berjalan terus-menerus.
// ══════════════════════════════════════════════════════

// Daftar mesin fingerprint yang dikonfigurasi lewat menu Pengaturan Absensi.
model AttendanceDevice {
  id        Int      @id @default(autoincrement())
  name      String   @unique // nama lokasi, mis. "Pusat", "Bungah", "Menganti"
  ip        String
  loginUser String
  loginPass String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("attendance_devices")
}

// Log mentah hasil scraping mesin fingerprint — satu baris per event tap
// (Check-In/Check-Out/OT-In/OT-Out). userPin & name persis apa yang
// tercatat di mesin (bisa beda-beda per device/PIN belum tentu unik
// secara global). Penghubung ke Employee ada di Employee.pinAttendance
// (dipetakan MANUAL oleh admin) — BUKAN foreign key langsung, supaya data
// mentah tetap tersimpan apa adanya walau pemetaannya belum/tidak lengkap.
model AttendanceLog {
  id         Int      @id @default(autoincrement())
  userPin    String
  name       String   @default("")
  location   String   @default("Pusat")
  logTime    DateTime
  verifyType String   @default("Fingerprint") // PIN | Fingerprint | Card
  logType    String   @default("Check-In") // Check-In | Check-Out | OT-In | OT-Out — tetap disimpan apa adanya, TIDAK dihapus
  // Dihitung & disimpan SEKALI saat sync (bukan saat baris ini ditampilkan)
  // dengan membandingkan logTime ke jam WorkShift pegawai pemilik PIN ini
  // (lihat lib/attendance/attendance-note.ts) — "Terlambat" kalau Check-In
  // lewat jam masuk shift, "Pulang Cepat" kalau Check-Out sebelum jam
  // pulang shift, null kalau tepat waktu / PIN belum dipetakan / pegawai
  // belum punya shift.
  note       String?
  syncedAt   DateTime @default(now())

  @@unique([userPin, location, logTime])
  @@index([logTime])
  @@map("attendance_logs")
}

// Singleton (selalu id=1) — pengaturan interval polling kalau nanti mau
// dijadikan auto-sync berkala. Untuk sekarang dipakai sebagai penyimpanan
// preferensi, sync-nya sendiri dipicu manual lewat tombol "Ambil Data Mesin".
enum AttendanceSyncMode {
  INTERVAL // ambil data berkala tiap N detik (pollSeconds), sepanjang hari
  SCHEDULED // cuma ambil data persis di jam:menit yang didaftarkan (scheduledTimes)
}

model AttendanceSettings {
  id          Int                @id @default(1)
  // Saklar utama — false = auto-sync sama sekali tidak jalan (baik mode
  // INTERVAL maupun SCHEDULED), tombol "Ambil Data Mesin" manual di Data
  // Absensi tetap berfungsi terlepas dari ini.
  enabled     Boolean            @default(true)
  pollSeconds Int                @default(10)
  syncMode    AttendanceSyncMode @default(INTERVAL)
  // Daftar jam:menit ("HH:mm", dipisah koma, mis. "08:00,12:00,17:00") —
  // dipakai kalau syncMode=SCHEDULED. Dicek tiap menit oleh
  // lib/attendance/auto-sync-scheduler.ts, bukan cron OS sungguhan (app ini
  // tidak punya akses ke cron level sistem) — tapi efeknya sama: sinkronisasi
  // cuma jalan di jam-jam yang ditentukan, bukan terus-menerus.
  scheduledTimes String?

  @@map("attendance_settings")
}

// ══════════════════════════════════════════════════════
//  PAYROLL
// ══════════════════════════════════════════════════════

// Seksi tempat komponen ini nongol di slip gaji (lihat contoh slip: bagian
// "PENERIMAAN" masuk Bruto, "PENERIMAAN LAIN" di luar Bruto, "POTONGAN", dan
// "PINJAMAN" masing-masing seksi terpisah).
enum SalaryComponentCategory {
  PENDAPATAN_TETAP // mis. Gaji Pokok, Tunj. Jabatan — masuk hitungan Bruto
  PENDAPATAN_TIDAK_TETAP // mis. Insentif, Lembur, SPPD — DI LUAR Bruto ("Penerimaan Lain")
  POTONGAN
  PINJAMAN
}

// Cara sistem nentuin nominal komponen ini tiap periode payroll (lihat
// server/actions/salary-component.ts untuk validasi field mana yang wajib
// per jenis). Nilai aktual PER PEGAWAI (mis. gaji pokok si A berapa) BUKAN
// disimpan di sini — tabel ini cuma DEFINISI komponennya, nilai per pegawai
// menyusul di fase berikutnya (Struktur Gaji / assignment ke pegawai).
enum SalaryComponentCalculationType {
  NOMINAL_TETAP // diisi manual per pegawai, tetap dipakai sampai diubah
  PERSENTASE // dihitung dari persentase komponen lain (lihat baseComponent) — persentase 100 dipakai buat pola "gross-up" BPJS Perusahaan yang nongol di Penerimaan & Potongan dengan nominal sama
  KEHADIRAN // ditarik dari data absensi/izin yang sudah ada (mis. Tunj. Kehadiran, Pot. Kehadiran/Punishment)
  MANUAL_PERIODE // admin isi ulang tiap proses payroll (nilainya beda tiap bulan)
}

model SalaryComponent {
  id   Int    @id @default(autoincrement())
  name String

  category        SalaryComponentCategory
  calculationType SalaryComponentCalculationType

  // Dipakai kalau calculationType = PERSENTASE.
  percentageValue Float?
  baseComponentId Int?

  includedInBruto Boolean @default(true) // true = seksi "Penerimaan" (masuk Bruto), false = "Penerimaan Lain" — cuma relevan buat kategori PENDAPATAN_*
  isTaxable       Boolean @default(false) // disimpan dari sekarang, dipakai nanti pas modul PPh 21 (BPJS & Pajak) dibangun
  // Tandai SATU komponen (biasanya "Gaji Pokok") sebagai nilai yang diambil
  // OTOMATIS dari Skala Gaji PP (SalaryGradeRate, lihat golongan+step pegawai
  // + versi aktif) saat Proses Payroll — nilai NOMINAL_TETAP yang diassign
  // manual di EmployeeSalaryComponent cuma dipakai sebagai FALLBACK kalau
  // pegawai belum punya golongan lengkap / tidak ada versi PP aktif.
  isBaseSalary    Boolean @default(false)
  displayOrder    Int     @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baseComponent       SalaryComponent?  @relation("SalaryComponentBase", fields: [baseComponentId], references: [id])
  dependentComponents SalaryComponent[] @relation("SalaryComponentBase")
  employeeAssignments EmployeeSalaryComponent[]
  payslipItems        PayslipItem[]
  manualEntries       PayrollManualEntry[]

  @@map("salary_components")
}

// Nilai komponen gaji PER PEGAWAI — mis. pegawai A dapat Tunj. Jabatan Rp
// 500rb, pegawai B ikut BPJS Kesehatan atau tidak. `amount` cuma dipakai
// kalau calculationType komponennya NOMINAL_TETAP (nominal manual per
// pegawai); untuk PERSENTASE `amount` dibiarkan kosong karena nilainya
// otomatis dihitung dari baseComponent saat Proses Payroll — baris di sini
// cuma menandakan pegawai itu IKUT/tidak komponen tsb. Komponen bertipe
// KEHADIRAN/MANUAL_PERIODE SENGAJA tidak diassign di sini karena nilainya
// beda tiap periode, bukan nilai tetap per pegawai (diisi langsung saat
// Proses Payroll, menyusul di fase berikutnya).
model EmployeeSalaryComponent {
  id                Int   @id @default(autoincrement())
  employeeId        Int
  salaryComponentId Int
  amount            Float?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([employeeId, salaryComponentId])
  @@map("employee_salary_components")
}

// Golongan gaji — format tampil "C-1/1" di slip (PKT/GOL) dibaca sebagai
// Golongan "C", Ruang "1", Step masa kerja "1". Satu baris di sini = satu
// kombinasi Golongan+Ruang (mis. "C-1"). minSalary/maxSalary tetap cuma
// dipakai buat VALIDASI/PERINGATAN longgar saat set Gaji Pokok pegawai
// manual (bukan auto-isi) — nominal PASTI per Golongan-Ruang-Step (MKG)
// disimpan terpisah di SalaryGradeRate, mengacu tabel resmi PP (lihat
// SalaryScaleVersion) karena tabel itu tidak berbentuk rentang tapi lookup
// exact per baris MKG. Golongan ini menempel LANGSUNG ke pegawai (independen
// dari Jabatan).
model SalaryGrade {
  id       Int    @id @default(autoincrement())
  code     String // Golongan, mis. "C"
  subGrade String // Ruang, mis. "1"

  minSalary    Float?
  maxSalary    Float?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  rates     SalaryGradeRate[]

  @@unique([code, subGrade])
  @@map("salary_grades")
}

// Satu "versi" tabel gaji pokok resmi (mis. "PP No. 15 Tahun 2019") —
// isActive dipakai sebagai toggle manual: cuma boleh ADA SATU versi aktif
// dalam satu waktu (lihat toggleSalaryScaleVersionActiveAction), itulah versi
// yang dipakai proses payroll buat lookup gaji pokok pegawai. Versi lain
// (non-aktif) tetap disimpan sebagai arsip histori kalau ada revisi PP baru.
model SalaryScaleVersion {
  id            Int      @id @default(autoincrement())
  name          String // mis. "PP No. 15 Tahun 2019"
  effectiveDate DateTime
  isActive      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates SalaryGradeRate[]

  @@map("salary_scale_versions")
}

// Nominal gaji pokok PASTI per kombinasi Golongan-Ruang (SalaryGrade) + Step
// (MKG) pada satu versi tabel PP tertentu — satu baris = satu sel di tabel
// resmi (mis. Golongan III Ruang a, MKG 0 = Rp 2.579.400).
model SalaryGradeRate {
  id            Int   @id @default(autoincrement())
  versionId     Int
  salaryGradeId Int
  step          Int // MKG (masa kerja golongan)
  amount        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version     SalaryScaleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  salaryGrade SalaryGrade        @relation(fields: [salaryGradeId], references: [id])

  @@unique([versionId, salaryGradeId, step])
  @@map("salary_grade_rates")
}

// Rate iuran BPJS Kesehatan & Ketenagakerjaan — SATU baris singleton (selalu
// id=1, sama seperti AttendanceSettings) karena rate ini berlaku sama untuk
// seluruh perusahaan, bukan per pegawai/per versi. Field *Percent dalam
// satuan persen (mis. 1 = 1%), *Cap dalam Rupiah (batas atas gaji yang
// dipakai sebagai dasar perhitungan, null = tidak dibatasi).
// Metode perhitungan PPh 21 bulanan — dipakai global buat semua pegawai
// saat Proses Payroll (lihat lib/payroll/calculate.ts):
// - GROSS: pegawai menanggung sendiri PPh 21-nya, dipotong langsung dari gaji.
// - GROSS_UP: perusahaan kasih "Tunjangan PPh 21" (nominal pas sama dengan
//   pajaknya sendiri) supaya take-home pay pegawai tidak berkurang gara-gara
//   pajak, tapi tunjangannya sendiri kena pajak juga (dihitung iteratif).
// - NET: perusahaan menanggung penuh PPh 21 (Ditanggung Perusahaan/DTP) —
//   dihitung buat pelaporan tapi TIDAK memotong gaji pegawai sama sekali.
// - TER: PPh 21 = Penghasilan Bruto bulan ini × Tarif Efektif Rata-rata
//   (PMK 168/2023), dipakai buat masa pajak Januari-November. Masa pajak
//   terakhir (Desember)/resign/pensiun SEHARUSNYA direkonsiliasi ulang pakai
//   tarif progresif Pasal 17 (dikurangi PPh 21 yang sudah dipotong TER
//   Jan-Nov) — belum diimplementasikan di sini, TER dipakai apa adanya
//   tiap periode buat sekarang.
enum Pph21Method {
  GROSS
  GROSS_UP
  NET
  TER
}

// Kategori TER (PMK 168/2023) — ditentukan dari status PTKP pegawai, LIHAT
// TER_CATEGORY_BY_PTKP_STATUS di lib/validations/payroll-tax.ts (aturan
// tetap dari regulasi, bukan data yang di-edit admin):
//   A: TK/0, TK/1, K/0
//   B: TK/2, TK/3, K/1, K/2
//   C: K/3
enum TerCategory {
  A
  B
  C
}

// Tabel tarif TER per kategori & lapisan penghasilan bruto BULANAN (beda
// dari TaxBracket yang tahunan) — nominalnya resmi dari lampiran PMK
// 168/2023, disimpan di tabel (bukan hardcode) supaya admin bisa
// update/isi sendiri kalau ada revisi aturan.
model TerRate {
  id          Int         @id @default(autoincrement())
  category    TerCategory
  order       Int         @default(0)
  minIncome   Float // penghasilan bruto BULANAN dari (Rp)
  maxIncome   Float? // sampai (Rp), null = tidak terbatas
  ratePercent Float
  updatedAt   DateTime    @updatedAt

  @@map("ter_rates")
}

model BpjsSettings {
  id Int @id @default(1)

  pph21Method Pph21Method @default(GROSS)

  kesehatanEmployeePercent Float @default(1) // ditanggung pegawai
  kesehatanCompanyPercent  Float @default(4) // ditanggung perusahaan
  kesehatanSalaryCap       Float? // mis. Rp 12.000.000 (batas atas resmi BPJS Kesehatan)

  jhtEmployeePercent Float  @default(2)
  jhtCompanyPercent  Float  @default(3.7)
  jpEmployeePercent  Float  @default(1)
  jpCompanyPercent   Float  @default(2)
  jpSalaryCap        Float? // JP resmi punya batas atas gaji berbeda dari JHT/Kesehatan
  jkkCompanyPercent  Float  @default(0.24) // tarif bervariasi per kelas risiko, disimpan sebagai satu nilai default
  jkmCompanyPercent  Float  @default(0.3)

  updatedAt DateTime @updatedAt

  @@map("bpjs_settings")
}

// Status PTKP (Penghasilan Tidak Kena Pajak) buat PPh 21 — kombinasi status
// kawin (TK/K) + jumlah tanggungan (0-3, maks 3 sesuai UU). Nominal per
// status BISA berubah kalau ada revisi peraturan pajak, makanya disimpan di
// tabel (bukan konstanta kode) supaya admin bisa update sendiri tanpa deploy.
enum PtkpStatus {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

model PtkpRate {
  status       PtkpStatus @id
  annualAmount Float // PTKP setahun, dibagi 12 saat dipakai di perhitungan bulanan

  updatedAt DateTime @updatedAt

  @@map("ptkp_rates")
}

// Lapisan tarif PPh 21 progresif (UU HPP) — minIncome/maxIncome dalam Rupiah
// SETAHUN, maxIncome null = lapisan teratas (tidak terbatas). Admin bisa
// tambah/ubah/hapus lapisan kalau ada revisi tarif, diurutkan lewat `order`.
model TaxBracket {
  id         Int    @id @default(autoincrement())
  order      Int    @default(0)
  minIncome  Float
  maxIncome  Float?
  ratePercent Float

  updatedAt DateTime @updatedAt

  @@map("tax_brackets")
}

enum PayrollPeriodStatus {
  DRAFT // masih bisa di-generate ulang/dihapus
  PENDING_APPROVAL // diajukan HR_ADMIN, menunggu SUPER_ADMIN approve/tolak — generate & manual entry dibekukan
  LOCKED // sudah di-approve SUPER_ADMIN & otomatis terkunci, payslip di dalamnya final (tidak boleh generate ulang)
}

// Pengaturan umum modul Payroll (singleton, id selalu 1 — sama pola dengan
// BpjsSettings/AttendanceSettings). cutoffDay dipakai createPayrollPeriodAction
// buat menghitung periodStart/periodEnd periode BARU — mengubah cutoffDay
// TIDAK memengaruhi periode yang sudah dibuat (tanggalnya sudah disimpan
// eksplisit per periode, lihat catatan di PayrollPeriod). paymentDay &
// rekening bank sifatnya informasi/tampilan saja (belum dipakai kalkulasi
// apa pun).
model PayrollSettings {
  id Int @id @default(1)

  cutoffDay  Int @default(21) // tanggal mulai potong periode baru (1-28, aman semua bulan termasuk Februari)
  paymentDay Int @default(25) // tanggal gaji biasanya ditransfer — informasi saja, ditampilkan di halaman Pengaturan Payroll

  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?

  // Kop surat perusahaan (banner gambar — logo + nama + alamat perusahaan
  // sesuai desain resmi mereka) — dipakai di bagian atas PDF Slip Gaji kalau
  // sudah diupload. null = PDF pakai judul biasa tanpa kop surat.
  letterheadUrl String?

  // Teks watermark yang diulang memenuhi seluruh halaman PDF Slip Gaji (mis.
  // "RAHASIA" / "COPY") — diagonal, transparan, di belakang konten. null/""
  // = tidak ada watermark.
  watermarkText String?

  updatedAt DateTime @updatedAt

  @@map("payroll_settings")
}

// Satu periode payroll — SELALU tanggal 21 bulan sebelumnya s/d 20 bulan
// berjalan (kesepakatan awal modul ini), makanya periodStart/periodEnd
// disimpan eksplisit alih-alih dihitung ulang tiap kali dari year/month.
model PayrollPeriod {
  id          Int                 @id @default(autoincrement())
  year        Int
  month       Int // 1-12, bulan pembayaran (bukan bulan mulai cut-off)
  periodStart DateTime            @db.Date
  periodEnd   DateTime            @db.Date
  status      PayrollPeriodStatus @default(DRAFT)
  lockedAt    DateTime?
  lockedBy    String?

  // Diisi saat HR_ADMIN mengajukan approval (DRAFT -> PENDING_APPROVAL) —
  // dikosongkan lagi begitu SUPER_ADMIN approve (lanjut ke LOCKED) atau
  // tolak (balik ke DRAFT, lihat rejectionReason).
  submittedForApprovalAt DateTime?
  submittedForApprovalBy String?
  // Alasan penolakan SUPER_ADMIN saat PENDING_APPROVAL -> DRAFT — TIDAK
  // dikosongkan otomatis saat submit ulang, biar HR_ADMIN masih bisa lihat
  // catatan penolakan terakhir sebagai konteks sebelum mengajukan lagi.
  rejectionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips     Payslip[]
  manualEntries PayrollManualEntry[]

  @@unique([year, month])
  @@map("payroll_periods")
}

// Hasil perhitungan payroll SATU pegawai SATU periode — angka total di sini
// SNAPSHOT hasil hitung saat digenerate (bukan dihitung ulang on-the-fly),
// jadi kalau master data komponen/tarif berubah belakangan, payslip lama
// tetap konsisten dengan angka waktu itu. Rincian per komponen ada di
// PayslipItem.
model Payslip {
  id              Int   @id @default(autoincrement())
  payrollPeriodId Int
  employeeId      Int
  grossPay        Float // total penerimaan (bruto + penerimaan lain)
  totalDeduction  Float // total potongan + pinjaman + PPh 21
  pph21           Float @default(0)
  netPay          Float

  // Dasar pengenaan pajak bulan ini (penghasilan bruto dari komponen
  // isTaxable=true) — DISIMPAN EKSPLISIT (bukan dihitung ulang dari
  // PayslipItem + flag isTaxable komponen yang SEKARANG, yang bisa saja
  // sudah berubah) supaya rekonsiliasi akhir tahun/resign (lihat
  // lib/payroll/tax-reconciliation.ts) menjumlahkan angka yang PERSIS sama
  // dengan yang dipakai saat bulan itu benar-benar dihitung.
  taxableMonthly Float @default(0)
  // true kalau PPh 21 bulan ini dihitung lewat rekonsiliasi akhir
  // tahun/resign (Pasal 17, bukan TER) — buat ditandai di UI & jadi
  // penanda "berhenti jumlahkan dari sini" kalau nanti ada rekonsiliasi
  // susulan.
  isFinalTaxPeriod Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id])
  items         PayslipItem[]

  @@unique([payrollPeriodId, employeeId])
  @@map("payslips")
}

// Satu baris rincian komponen di satu payslip. `name`/`category` di-snapshot
// (bukan cuma baca dari SalaryComponent) supaya kalau nama komponen diubah
// belakangan, payslip lama tidak ikut berubah. salaryComponentId null buat
// baris spesial yang tidak berasal dari SalaryComponent manapun (mis. PPh 21
// yang dihitung otomatis lewat PtkpRate + TaxBracket, bukan dari komponen
// "PPh 21" MANUAL_PERIODE yang sengaja dilewati fase ini).
model PayslipItem {
  id                Int                      @id @default(autoincrement())
  payslipId         Int
  salaryComponentId Int?
  name              String
  detail            String?                  @db.Text // info tambahan ditampilkan di baris terpisah di bawah nama, mis. "21 hari x Rp30.000" buat Tunjangan Kehadiran — @db.Text karena bisa multi-baris & lebih dari 191 karakter
  category          SalaryComponentCategory
  amount            Float

  payslip         Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent? @relation(fields: [salaryComponentId], references: [id])

  @@map("payslip_items")
}

// Nilai komponen bertipe MANUAL_PERIODE (Insentif, Lembur, SPPD, Kredit,
// dst.) diisi admin PER PEGAWAI PER PERIODE di sini — beda dari
// EmployeeSalaryComponent yang nilainya tetap dipakai berulang tiap bulan.
// Baris di sini TAHAN terhadap generate ulang payslip (bukan bagian dari
// payslip/payslip_items yang dihapus-bikin-ulang tiap generate), jadi
// admin isi sekali per periode lalu klik Generate — hasilnya ikut terhitung.
model PayrollManualEntry {
  id                Int   @id @default(autoincrement())
  payrollPeriodId   Int
  employeeId        Int
  salaryComponentId Int
  amount            Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollPeriod   PayrollPeriod   @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([payrollPeriodId, employeeId, salaryComponentId])
  @@map("payroll_manual_entries")
}
