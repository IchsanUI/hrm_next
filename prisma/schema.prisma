  approvedAt       DateTime?
  rejectionReason  String?          @db.Text
  actionUnlockedAt DateTime? // pegawai diperbolehkan pulang cepat sejak waktu ini

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

