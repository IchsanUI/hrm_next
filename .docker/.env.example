#! TODO: copy file ini jadi ".env" di folder yang sama (.docker/.env), lalu
#! isi semua nilai di bawah. JANGAN commit .docker/.env ke git (sudah di
#! .gitignore) — file ini (.env.example) yang boleh commit, isinya cuma
#! placeholder.

#! ---- MariaDB ----
#! Jangan pakai root/root atau kredensial contoh apa pun di production.
MYSQL_ROOT_PASSWORD=ganti-ini
MYSQL_DATABASE=hrm_next
MYSQL_USER=hrm_next
MYSQL_PASSWORD=ganti-ini

#! ---- Koneksi Prisma ke MariaDB ----
#! host "localhost" karena container app & mariadb share network namespace
#! (lihat network_mode: service:app di docker-compose.yml) — BUKAN nama
#! service "mariadb", beda dari docker-compose biasa.
DATABASE_URL=mysql://hrm_next:ganti-ini@localhost:3306/hrm_next

#! ---- Auth (next-auth) ----
#! Generate secret baru: openssl rand -base64 32
NEXTAUTH_SECRET=ganti-ini
#! Domain publik aplikasi (dengan https://)
NEXTAUTH_URL=https://ganti-ini.example.com
# WAJIB true di deployment ini — Next.js jalan di belakang reverse proxy
# (nginx, lihat .docker/nginx/config/default.conf, dan biasanya Cloudflare di
# depannya). Tanpa ini Auth.js menolak header X-Forwarded-Host dari proxy dan
# menganggap host request tidak tepercaya, sehingga login/callback gagal.
AUTH_TRUST_HOST=true

#! ---- Enkripsi data pegawai sensitif ----
#! HARUS sama persis dengan yang dipakai saat data lama di-generate —
#! kalau ganti key di deployment yang sudah ada data, data lama tidak
#! akan bisa didekripsi lagi. Generate baru cuma untuk instalasi baru.
EMPLOYEE_DATA_ENCRYPTION_KEY=ganti-ini

#! ---- Enkripsi secret 2FA (TOTP) akun SUPER_ADMIN ----
#! SENGAJA terpisah dari EMPLOYEE_DATA_ENCRYPTION_KEY (isolasi blast-radius).
#! Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#! JANGAN diganti setelah ada akun yang aktifkan 2FA (sama alasannya seperti
#! EMPLOYEE_DATA_ENCRYPTION_KEY di atas).
TOTP_ENCRYPTION_KEY=ganti-ini

#! ---- Cloudflare Turnstile (captcha login) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=ganti-ini
TURNSTILE_SECRET_KEY=ganti-ini

#! ---- Web Push (VAPID) ----
#! Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=ganti-ini
VAPID_PRIVATE_KEY=ganti-ini
VAPID_SUBJECT=mailto:admin@example.com

#! ---- Cron endpoint (auto-reject lembur 24 jam, app/api/cron/reject-expired-overtime) ----
#! Generate string acak sendiri, dipakai sebagai Bearer token di cron job eksternal.
CRON_SECRET=ganti-ini
